# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Docker Compose reads this file for both the api service and ${...} interpolation.
# Running the API without Docker? It reads apps/api/.env (or legacy apps/api/config/.env).

# ---------- Required (API) ----------
# MongoDB connection string. Ignored in development (docker-compose.dev.yml uses the local mongo container).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Authorization header prefix, e.g. "<BEARER_KEY><jwt>". Also baked into the web build.
BEARER_KEY=change-me-bearer-prefix__
# JWT signing secret for login tokens.
TOKEN_SIGNATURE=change-me-token-signature
# JWT signing secret for email-confirmation links.
EMAIL_TOKEN=change-me-email-token-secret
# bcrypt cost factor.
SALT_ROUND=8

# ---------- Optional (API) ----------
# Base URL of the web app, used for Stripe redirects and post-confirmation redirects.
FRONTEND_URL=http://localhost:8080
# Folder prefix for Cloudinary uploads.
APP_NAME=bookstore
# "false" lets new accounts log in without confirming their email.
# Defaults: true for the API / production, false in docker-compose.dev.yml.
# REQUIRE_EMAIL_CONFIRMATION=true

# Cloudinary (book cover uploads). Without these, adding/editing book images returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (card payments). Without STRIPE_SECRET_KEY, card orders return 503.
STRIPE_SECRET_KEY=
# Webhook endpoint: <public url>/api/order/webhook (production compose).
STRIPE_WEBHOOK_SECRET=

# Gmail account used to send confirmation emails (use an app password).
EMAIL=
EMAIL_PASSWORD=

# ---------- Docker host ports ----------
# Production: the only published port (nginx serving the web app and /api).
WEB_PORT=8080
# Development (bound to 127.0.0.1 only).
DEV_WEB_PORT=3000
DEV_API_PORT=4000
DEV_MONGO_PORT=27017
