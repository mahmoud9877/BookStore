# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Docker Compose reads this file for both the api service and ${...} interpolation.
# Running the API without Docker? It reads apps/api/.env (or legacy apps/api/config/.env).

# ---------- Required (API) ----------
# MongoDB connection string. Must be a replica set (transactions): MongoDB Atlas, or the bundled
# single-node set (docker compose --profile local-db: mongodb://mongo:27017/library?replicaSet=rs0).
# Ignored in development (docker-compose.dev.yml uses the local mongo container).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Authorization header prefix, e.g. "<BEARER_KEY><jwt>". Also baked into the web build.
BEARER_KEY=change-me-bearer-prefix__
# JWT signing secret for login tokens.
TOKEN_SIGNATURE=change-me-token-signature
# JWT signing secret for email-confirmation links.
EMAIL_TOKEN=change-me-email-token-secret
# bcrypt cost factor.
SALT_ROUND=8

# ---------- Optional (API) ----------
# Base URL of the web app, used for Stripe redirects and post-confirmation redirects.
FRONTEND_URL=http://localhost:8080
# Folder prefix for Cloudinary uploads.
APP_NAME=bookstore
# "false" lets new accounts log in without confirming their email.
# Defaults: true for the API / production, false in docker-compose.dev.yml.
# REQUIRE_EMAIL_CONFIRMATION=true

# Cloudinary (book cover uploads). Without these, adding/editing book images returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (card payments for shop orders and library fines). Without STRIPE_SECRET_KEY,
# card checkouts return 503 and members pay at a desk instead.
STRIPE_SECRET_KEY=
# Webhook endpoint: <public url>/api/payments/webhook (the legacy /api/order/webhook
# works too). Subscribe to checkout.session.completed, .expired and .async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# ---------- Email ----------
# "gmail" sends real email with EMAIL/EMAIL_PASSWORD; "log" only prints messages.
# Default: gmail in production, log otherwise (development never emails anyone).
# MAIL_TRANSPORT=log
# Gmail account used to send email (use an app password).
EMAIL=
EMAIL_PASSWORD=
# Sender name shown in members' inboxes.
MAIL_FROM_NAME=Library

# Browser origins allowed to call the API, comma-separated (default: any origin).
# CORS_ORIGINS=https://library.example.org

# ---------- Files ----------
# Where covers (without Cloudinary), digital publications and purchase documents are
# stored. Docker mounts the "uploads" volume here; back it up with the database.
# UPLOAD_DIR=/app/uploads

# ---------- Background worker ----------
# How often the worker checks for due jobs (milliseconds).
# WORKER_INTERVAL_MS=60000

# ---------- Optional AI catalogue assistant ----------
# Without a key, "Ask the catalogue" uses keyword search. With one, Claude turns the
# question into search filters and answers only from the matching catalogue records.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# ---------- Docker host ports ----------
# Production: the only published port (nginx serving the web app and /api).
WEB_PORT=8080
# Development (bound to 127.0.0.1 only).
DEV_WEB_PORT=3000
DEV_API_PORT=4000
DEV_MONGO_PORT=27017
