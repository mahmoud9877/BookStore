{
  "name": "@bookstore/api",
  "version": "1.0.0",
  "description": "Library management API (Express + MongoDB)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "test": "node --test --import ./tests/setup-env.js tests/*.test.js",
    "worker": "node src/worker.js",
    "worker:dev": "nodemon --watch src src/worker.js",
    "migrate": "node src/migrate.js up",
    "migrate:status": "node src/migrate.js status",
    "test:integration": "node --test --test-concurrency=1 --import ./tests/integration/setup-env.js tests/integration/*.test.js",
    "seed:demo": "node src/seed-demo.js"
  },
  "engines": {
    "node": "20.x"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.8.0",
    "stripe": "^16.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "private": true
}
